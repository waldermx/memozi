{
  "name": "memozi",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "MemoZi — open-source Chinese character writing app with FSRS spaced repetition",
  "packageManager": "pnpm@10.19.0",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "licenses:check": "node scripts/check-licenses.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\" --ignore-path .gitignore",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.3",
    "typescript": "~5.6.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "core-js",
      "cypress",
      "esbuild",
      "prisma"
    ]
  }
}
