# MemoZi Backend — Development Dockerfile with hot reload
# Build context: monorepo root  (docker compose up — context: .)
FROM node:22-alpine

RUN corepack enable pnpm

WORKDIR /app

# Install all workspace deps using the root lockfile.
# Source files are bind-mounted at runtime; only manifests are baked in.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend/package.json  ./backend/
COPY frontend/package.json ./frontend/
COPY shared/package.json   ./shared/
# prisma generate runs explicitly after install — schema must exist before install.
COPY backend/prisma/schema.prisma ./backend/prisma/schema.prisma
# --ignore-scripts skips postinstall hooks (avoids pnpm 11 ERR_PNPM_IGNORED_BUILDS);
# prisma generate is run explicitly so the client is available at runtime.
RUN pnpm install --frozen-lockfile --ignore-scripts
RUN cd /app/backend && node_modules/.bin/prisma generate

WORKDIR /app/backend

EXPOSE 3000

CMD ["pnpm", "dev"]
