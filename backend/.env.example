# ─────────────────────────────────────────────────────────────────────────────
# MemoZi Backend — Environment Variables
# Copy this file to .env and fill in the values.
# .env is listed in .gitignore and must never be committed.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# Local development (PostgreSQL running on localhost)
DATABASE_URL="postgresql://memozi:memozi@localhost:5432/memozi?schema=public"
# Docker Compose service-to-service example
# DATABASE_URL="postgresql://memozi:memozidev@postgres:5432/memozi?schema=public"
# Production example
# DATABASE_URL="postgresql://memozi:CHANGE_ME@postgres:5432/memozi?schema=public"

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_BYTES_MINIMUM_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_FROM_JWT_SECRET_ALSO_64_BYTES

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * to allow all (not recommended for prod)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8100

# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Used by frontend build/runtime as API base URL.
VITE_API_URL=http://localhost:3000/api/v1

# ── Production (docker-compose.prod.yml / .env.prod) ───────────────────────
# These are required by root docker-compose.prod.yml.

# Image repository/tag for GHCR images
GITHUB_REPOSITORY=your-org-or-user/your-repo
IMAGE_TAG=latest

# Domains used by Traefik routers
API_DOMAIN=api.example.com
APP_DOMAIN=example.com

# PostgreSQL service credentials
DB_USER=memozi
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
DB_NAME=memozi

# Redis auth
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD

# Grafana admin password
GRAFANA_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD
